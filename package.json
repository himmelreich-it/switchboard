{
  "name": "switchboard",
  "productName": "Switchboard",
  "version": "0.1.0",
  "module": "server.ts",
  "main": "electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "app": "electron electron/main.js",
    "app:linux": "electron electron/main.js --no-sandbox",
    "vendor": "bun vendor/build.ts",
    "package:mac": "electron-builder --mac --dir",
    "package:linux": "electron-builder --linux --dir",
    "package:win": "electron-builder --win --dir",
    "install-local:linux": "bash scripts/install-linux.sh",
    "install-local:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "install-local": "osascript -e 'quit app \"Switchboard\"' || true; bun run package:mac && rm -rf /Applications/Switchboard.app && cp -R dist/mac*/Switchboard.app /Applications/ && rm -rf dist && echo 'Installed /Applications/Switchboard.app'"
  },
  "build": {
    "appId": "dev.himmelreich.switchboard",
    "productName": "Switchboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.ts",
      "runner.ts",
      "acp.ts",
      "apptools.ts",
      "lib.ts",
      "index.html",
      "images/**",
      "vendor/*.js",
      "vendor/*.css",
      "vendor/fonts/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*-musl/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "icon": "images/icons/macos/Switchboard.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "dir",
      "executableName": "switchboard",
      "category": "Development"
    },
    "win": {
      "target": "dir",
      "icon": "images/icons/flat/switchboard.ico"
    }
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/bun": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "marked": "12"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.86.0",
    "@agentclientprotocol/sdk": "1.7.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.5"
  }
}
